# ──────────────────────────────────────────────────────────────
#  la-ny-viaje — environment variables
#  Copy this file to `.env.local` and fill in the values.
#  The app RUNS WITHOUT these (it falls back to local seed data),
#  but Firebase + Mapbox features come alive once they're set.
# ──────────────────────────────────────────────────────────────

# ── Firebase (client) ────────────────────────────────────────
# Firebase console → Project settings → Your apps → SDK setup & config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Maps & Weather ───────────────────────────────────────────
# No keys needed! Maps use OpenStreetMap/CARTO tiles (Leaflet) and weather
# uses Open-Meteo — both free and keyless. The USD→COP rate uses open.er-api.com.

# ── Firebase Admin (server-only — used by the seed script) ───
# Firebase console → Project settings → Service accounts → Generate new private key
# Paste the whole JSON on one line, OR point to the file path.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
