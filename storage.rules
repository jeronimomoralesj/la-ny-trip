rules_version = '2';

// Photos, documents and feed images — only the signed-in squad can read/write.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024); // 20MB cap
    }
  }
}
